{
  "name": "r2beam",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "A self-hosted media vault on Cloudflare R2",
  "cloudflare": {
    "bindings": {
      "MEDIA": {
        "description": "R2Beam이 원본과 최적화 미디어를 보관할 R2 버킷입니다."
      }
    }
  },
  "scripts": {
    "build": "node scripts/sync-media-vendor.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "installer:check": "npm --prefix installer run check",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
