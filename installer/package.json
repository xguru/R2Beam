{
  "name": "r2beam-installer",
  "private": true,
  "type": "module",
  "scripts": {
    "build:release": "node scripts/build-release.mjs",
    "dev": "npm run build:release && wrangler dev",
    "deploy": "npm run build:release && wrangler deploy",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build:release && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
